{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "issues": "https://github.com/starfish-studios/Naturalist/issues"
  },
  "license": "${mod_license}",
  "icon": "icon.png",
  "environment": "*",
  "accessWidener": "naturalist.accesswidener",
  "entrypoints": {
    "main": [
      "com.starfish_studios.naturalist.fabric.NaturalistFabric"
    ],
    "client": [
      "com.starfish_studios.naturalist.fabric.client.NaturalistFabricClient"
    ],
    "lambdynlights:initializer": [
      "com.starfish_studios.naturalist.client.compat.LambDynamicLightsCompat"
    ]
  },
  "mixins": [
    "naturalist.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=21",
    "geckolib": ">=${geckolib_version}"
  },
  "suggests": {
    "lambdynlights": "*"
  }
}
