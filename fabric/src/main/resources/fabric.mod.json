{
  "schemaVersion": 1,
  "id": "naturalist",
  "version": "${version}",
  "name": "Naturalist",
  "description": "Enhances the overworld by adding new wildlife with unique behavior.",
  "authors": ["Starfish Studios", "CrispyTwig"],
  "contact": {
    "issues": "https://github.com/crispytwig/Naturalist/issues",
    "sources": "https://github.com/crispytwig/Naturalist"
  },
  "license": "All Rights Reserved / MIT (see LICENSE)",
  "icon": "naturalist.png",
  "environment": "*",
  "accessWidener": "naturalist.accesswidener",
  "entrypoints": {
    "main": ["com.crispytwig.naturalist.fabric.NaturalistFabric"],
    "client": ["com.crispytwig.naturalist.fabric.client.NaturalistFabricClient"]
  },
  "mixins": ["naturalist.mixins.json"],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "~${minecraft_version}",
    "java": ">=25"
